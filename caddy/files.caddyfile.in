# DEPRECATED 2026-06-03 — the canonical config is now caddy/files.caddyfile (committed verbatim).
# This file/script is retained for reference only. Do not run.

# Renders to /etc/caddy/conf.d/files.caddyfile via scripts/caddy-files-render.sh.
# Regenerate after rotating HERMES_FILES_PASSWORD in /etc/claude-soma/secrets.env.

__FILES_DOMAIN__ {
    basicauth /* {
        soma __BCRYPT_HASH__
    }
    encode gzip zstd
    file_server browse {
        root /var/lib/claude-soma/relay
        hide .* index.html
    }
    log {
        output file /var/log/caddy/files-access.log
        format json
    }
    header {
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
        Cache-Control "private, max-age=300"
        -Server
    }
}
