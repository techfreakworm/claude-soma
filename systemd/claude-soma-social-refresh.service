[Unit]
Description=Claude Soma social token refresh (oneshot sweep)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/claude-soma
EnvironmentFile=/etc/claude-soma/secrets.env
Environment=PATH=/opt/claude-soma/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_SOCIAL_DB=/var/lib/claude-soma/social.sqlite
ExecStart=/opt/claude-soma/.venv/bin/python -m claude_soma.social.refresh
StandardOutput=append:/var/log/claude-soma/social-refresh.log
StandardError=append:/var/log/claude-soma/social-refresh.err.log
