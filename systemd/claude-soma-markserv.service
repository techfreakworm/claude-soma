[Unit]
Description=Claude Soma file relay (markserv on /var/lib/claude-soma/relay served via FILES_DOMAIN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/lib/claude-soma/relay
ExecStart=/opt/claude-soma/scripts/markserv-launch.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
