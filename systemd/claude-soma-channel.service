# systemd/claude-soma-channel.service
#
# Persistent claude --channels session driving the Telegram bot. Lives inside
# a tmux session named "hermes" so the operator can `tmux a -t hermes` to
# watch / interact, and so claude has a real PTY (claude detects pipes and
# switches to --print mode, which doesn't run channels).
#
# Logging trick: we deliberately do NOT pipe the claude command through `tee`
# (that breaks claude's TTY detection). Instead, we let tmux own the PTY and
# tap it with `tmux pipe-pane` in an ExecStartPost. Output streams to
# /var/log/claude-soma/channel.log without ever leaving a TTY in the chain.
#
# To switch from a manually-managed tmux session to this systemd-managed one:
#   1. In your manual session: /quit  (or Ctrl-C twice to exit claude)
#   2. tmux kill-session -t <your-session-name>
#   3. sudo systemctl enable --now claude-soma-channel.service
#   4. tmux a -t hermes   (to watch)

[Unit]
Description=Claude Soma persistent Telegram channel session
After=network-online.target
Wants=network-online.target

[Service]
# Type=oneshot + RemainAfterExit=yes: we start the tmux session and
# consider the service "active" indefinitely without trying to track a
# main process. systemd's Type=forking didn't work here because tmux
# daemonizes too deeply for systemd to find a MainPID, which caused a
# restart loop (each cycle thought the service had exited, then ExecStop
# killed the tmux session, then Restart=always re-fired).
#
# Recovery: if claude inside tmux dies, the tmux session goes empty but
# stays alive — systemd doesn't notice. scripts/healthcheck.sh runs every
# 10 minutes and calls `systemctl restart` if `tmux has-session -t hermes`
# fails, which gives us a slow-but-reliable watchdog.
Type=oneshot
RemainAfterExit=yes
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/claude-soma
EnvironmentFile=/etc/claude-soma/secrets.env
Environment=PATH=/opt/claude-soma/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

ExecStartPre=/usr/bin/install -d -o ubuntu -g ubuntu /var/log/claude-soma
ExecStartPre=/bin/bash -c '/usr/bin/tmux kill-session -t hermes 2>/dev/null || true'

# tmux forks the server; the new-session call returns 0 after detaching, which
# is what Type=forking expects. Claude runs inside the detached pane with a
# real PTY.
# --dangerously-skip-permissions: required for autonomous bot operation. A
# bot has no human at the keyboard to approve tool calls, so any permission
# prompt would freeze it. Trade-off accepted: the bot can run any tool
# without confirmation, including Bash and Edit. Mitigated by Telegram
# access policy (allowlist) — only paired users can drive the bot.
# IMPORTANT: use the *native* claude install (~/.local/bin/claude). The npm
# package at /usr/bin/claude has a different binary that doesn't accept
# --channels (it silently falls into --print mode and errors). The native
# binary is installed via `claude install latest` and is the only one that
# supports the persistent channel-listener loop.
ExecStart=/usr/bin/tmux new-session -d -s hermes -c /opt/claude-soma /home/ubuntu/.local/bin/claude --channels plugin:telegram@claude-plugins-official --plugin-dir /opt/claude-soma --add-dir /home/ubuntu/hermes-work --dangerously-skip-permissions --effort max

# Give tmux ~1s to spin the pane, then tap its output to the log file. This
# is the TTY-safe equivalent of `| tee`.
ExecStartPost=/bin/sleep 1
ExecStartPost=/usr/bin/tmux pipe-pane -t hermes -o "cat >> /var/log/claude-soma/channel.log"

ExecStop=/usr/bin/tmux kill-session -t hermes 2>/dev/null || true

# Restart=on-failure (not always) — oneshot+RemainAfterExit means the
# service stays Active even after a clean start, so Restart=always
# would never fire anyway. on-failure covers the case where ExecStart
# itself fails (e.g. native claude missing, tmux broken).
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
