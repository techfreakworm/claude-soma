# systemd/claude-soma-channel.service
#
# Persistent claude --channels session driving the Telegram bot. Lives inside
# a tmux session named "hermes" so the operator can `tmux a -t hermes` to
# watch / interact, and so claude has a real PTY (claude detects pipes and
# switches to --print mode, which doesn't run channels).
#
# Logging trick: we deliberately do NOT pipe the claude command through `tee`
# (that breaks claude's TTY detection). Instead, we let tmux own the PTY and
# tap it with `tmux pipe-pane` in an ExecStartPost. Output streams to
# /var/log/claude-soma/channel.log without ever leaving a TTY in the chain.
#
# To switch from a manually-managed tmux session to this systemd-managed one:
#   1. In your manual session: /quit  (or Ctrl-C twice to exit claude)
#   2. tmux kill-session -t <your-session-name>
#   3. sudo systemctl enable --now claude-soma-channel.service
#   4. tmux a -t hermes   (to watch)

[Unit]
Description=Claude Soma persistent Telegram channel session
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/claude-soma
EnvironmentFile=/etc/claude-soma/secrets.env
Environment=PATH=/opt/claude-soma/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

ExecStartPre=/usr/bin/install -d -o ubuntu -g ubuntu /var/log/claude-soma
ExecStartPre=/bin/bash -c '/usr/bin/tmux kill-session -t hermes 2>/dev/null || true'

# tmux forks the server; the new-session call returns 0 after detaching, which
# is what Type=forking expects. Claude runs inside the detached pane with a
# real PTY.
ExecStart=/usr/bin/tmux new-session -d -s hermes -c /opt/claude-soma /usr/bin/claude --channels plugin:telegram@claude-plugins-official --plugin-dir /opt/claude-soma --add-dir /home/ubuntu/hermes-work --permission-mode default

# Give tmux ~1s to spin the pane, then tap its output to the log file. This
# is the TTY-safe equivalent of `| tee`.
ExecStartPost=/bin/sleep 1
ExecStartPost=/usr/bin/tmux pipe-pane -t hermes -o "cat >> /var/log/claude-soma/channel.log"

ExecStop=/usr/bin/tmux kill-session -t hermes

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
