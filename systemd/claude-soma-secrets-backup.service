# systemd/claude-soma-secrets-backup.service
[Unit]
Description=Claude Soma secrets backup (GPG-encrypted)
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/claude-soma
EnvironmentFile=/etc/claude-soma/secrets.env
Environment=PATH=/opt/claude-soma/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/claude-soma/scripts/backup-secrets.sh
StandardOutput=journal
StandardError=journal
