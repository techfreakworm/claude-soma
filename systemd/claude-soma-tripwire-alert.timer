# systemd/claude-soma-tripwire-alert.timer
#
# 09:30 IST daily — ahead of the operator's 10:00 IST reconnect, and ahead of the
# 10:00 IST daily-status DM. System clock is Asia/Kolkata, so OnCalendar is IST
# (= 04:00 UTC).
[Unit]
Description=Run the AI-bubble tripwire check daily at 09:30 IST

[Timer]
OnCalendar=*-*-* 09:30:00
# Catch up if the box was down at 09:30.
Persistent=true
# Avoid colliding with the 10:00 daily-status run on a slow boot.
RandomizedDelaySec=120
Unit=claude-soma-tripwire-alert.service

[Install]
WantedBy=timers.target
