{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/tg_reply_guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/session_start_context.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/notify_inject.sh"
          }
        ]
      },
      {
        "if": "event.meta.audio_path != null",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/voice_intake.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/orchestrator_gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__hermes_api__send_tg_reply|mcp__plugin_telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/heard_gate.py"
          },
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/relay_link_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/log_activity.sh"
          }
        ]
      },
      {
        "matcher": "mcp__voice-stt__transcribe",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude-soma/scripts/heard_gate.py"
          }
        ]
      }
    ]
  }
}
