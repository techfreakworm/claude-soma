# Caddyfile
#
# Placeholders (__SOMA_DOMAIN__, __ACME_EMAIL__) are substituted by
# scripts/finalize-caddy.sh from /etc/claude-soma/secrets.env after the
# operator fills SOMA_DOMAIN + ACME_EMAIL. The unrendered file is also
# installed at bootstrap step 13 — Caddy accepts the literal strings as
# site names (TLS acquisition fails silently) so caddy.service starts;
# finalize-caddy.sh re-renders + reloads once the operator runs it.
{
    email __ACME_EMAIL__
}

__SOMA_DOMAIN__ {
    # /api/auth/* → Next.js (port 3000). Next-auth owns these routes
    # (signin, callback, session, csrf, etc.) via app/api/auth/[...nextauth].
    # Must be matched BEFORE the generic /api/* rule below.
    handle /api/auth/* {
        reverse_proxy localhost:3000
    }

    # /api/admin/upload/* → Next.js (port 3000). The Next.js route handler at
    # app/api/admin/upload/[lead]/route.ts verifies the NextAuth session and
    # injects X-GitHub-Handle before proxying to FastAPI. Sending this path
    # directly to FastAPI (port 9000) would bypass that session check because
    # the browser never sets X-GitHub-Handle — only the server-side proxy does.
    handle /api/admin/upload/* {
        reverse_proxy localhost:3000
    }

    # /api/* → FastAPI (port 9000). Use `handle` (not `handle_path`) so the
    # full /api/<path> URL is forwarded as-is — FastAPI's routers all mount
    # under the /api prefix, so stripping it here would 404.
    # Strip any client-supplied X-GitHub-Handle so only the internal Next.js
    # fetch path (server-side, via middleware-set header) can authenticate.
    # Without this strip, a curl could spoof the auth header.
    handle /api/* {
        request_header -X-GitHub-Handle
        reverse_proxy localhost:9000
    }

    # Everything else → Next.js dashboard (port 3000).
    handle {
        reverse_proxy localhost:3000
    }

    encode gzip zstd
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 10
        }
    }
}

import /etc/caddy/conf.d/*.caddyfile
