# Caddyfile
{
    email mayank@mayankgupta.in
}

soma.mayankgupta.in {
    # /api/* → FastAPI (port 9000). Use `handle` (not `handle_path`) so the
    # full /api/<path> URL is forwarded as-is — FastAPI's routers all mount
    # under the /api prefix, so stripping it here would 404.
    # Strip any client-supplied X-GitHub-Handle so only the internal Next.js
    # fetch path (server-side, via middleware-set header) can authenticate.
    # Without this strip, a curl could spoof the auth header.
    handle /api/* {
        request_header -X-GitHub-Handle
        reverse_proxy localhost:9000
    }

    # Everything else → Next.js dashboard (port 3000).
    handle {
        reverse_proxy localhost:3000
    }

    encode gzip zstd
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 10
        }
    }
}
