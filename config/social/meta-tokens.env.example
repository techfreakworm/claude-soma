# Meta tokens config template — copy to ~/.config/social-manager/meta-tokens.env
# Set permissions: chmod 600 ~/.config/social-manager/meta-tokens.env
# DO NOT commit this file with real values.  The .example contains placeholders only.
#
# Three independent app spaces (each has its own App ID / Secret):
#   - Instagram-Login product  (IG_APP_ID / IG_APP_SECRET)
#   - Threads product          (THREADS_APP_ID / THREADS_APP_SECRET)
#   - Facebook Page product    (META_APP_ID / META_APP_SECRET)

# ---- Facebook / Page app credentials ----
META_APP_ID=
META_APP_SECRET=

# ---- Instagram-Login app credentials ----
IG_APP_ID=
IG_APP_SECRET=

# ---- Threads app credentials ----
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---- Webhook verification token (same string in each app's webhook config) ----
WEBHOOK_VERIFY_TOKEN=

# ---- Pre-provisioned long-lived tokens (bootstrap material) ----
# Leave blank if you prefer to obtain tokens via /oauth/start after deploying.
# The service reads these ONCE at startup to seed the vault; after that the
# vault is the authoritative source and these values are no longer read.

# Instagram: long-lived token (60d) + numeric user ID
IG_LONG_LIVED_TOKEN=
IG_USER_ID=

# Threads: long-lived token (60d) + numeric user ID
THREADS_LONG_LIVED_TOKEN=
THREADS_USER_ID=

# Facebook Page: non-expiring page token + numeric page ID
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
