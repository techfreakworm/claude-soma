# /etc/claude-soma/secrets.env — copy this file as the starting point
# Required keys are uncommented; optional keys are commented with "#"
# After editing, chmod 600 and chown ubuntu:ubuntu

# ========== CLAUDE / ANTHROPIC ==========
# Obtain via `claude login` on a dev machine first; required for the bot.
CLAUDE_CODE_OAUTH_TOKEN=

# ========== GITHUB OAUTH (dashboard auth) ==========
# Create at https://github.com/settings/developers (OAuth App)
# Callback URL: https://soma.<your-domain>/api/auth/callback/github
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Restrict access to a single GitHub user/org:
AUTH_GITHUB_OWNER=techfreakworm
# Optional: restrict to a team within the owner; leave empty for none:
AUTH_GITHUB_TEAM=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full external URL to the dashboard:
NEXTAUTH_URL=https://soma.<your-domain>

# ========== TELEGRAM ==========
# Obtain TELEGRAM_BOT_TOKEN from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal numeric chat id. DM your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
HERMES_NOTIFY_CHAT_ID=
# Same as HERMES_NOTIFY_CHAT_ID — fallback for older code paths
TELEGRAM_CHAT_ID=

# ========== FILES RELAY (basicauth password) ==========
# Plaintext password for the basicauth on files.<your-domain>
# After setting, regenerate the bcrypt hash in caddy/files.caddyfile (see INSTALL.md)
HERMES_FILES_PASSWORD=

# ========== AUTO-RESTART GUARD (optional) ==========
# Unix epoch (seconds) when the current auto-restart window expires.
# Leave commented to disable auto-restart.
# Example: 1796515200 (= 2026-12-01T00:00:00Z)
# HERMES_AUTO_RESTART_WINDOW_UTC=

# ========== USAGE-TAB CEILINGS (optional) ==========
# If set, the /admin/usage tab shows ceiling KpiCards with remaining-percent.
# If unset, ceiling cards are hidden (graceful).
# HERMES_INTERACTIVE_CEILING=10000
# HERMES_AGENT_SDK_CEILING=50000

# ========== ENGAGEMENT DRIP (optional knobs) ==========
# Below this threshold of queued drafts, the drip script writes a REFILL_NEEDED flag.
# HERMES_ENGAGEMENT_REFILL_THRESHOLD=6
# Override the queue + review-page paths if you've moved them:
# HERMES_ENGAGEMENT_QUEUE=/var/lib/claude-soma/engagement/queue.jsonl
# HERMES_ENGAGEMENT_REVIEW_PAGE=/var/lib/claude-soma/relay/engagement-review.md

# ========== HUGGING FACE (optional, for HF MCP / leads using hf CLI) ==========
# Obtain via `hf auth login` interactive flow.
# HUGGING_FACE_HUB_TOKEN=

# ========== EXTERNAL CLI BINARIES — install separately ==========
# grok (xAI) — install from https://grok.com/cli — required for grok-image MCP
# codex (OpenAI Codex) — install from https://github.com/openai/codex — required for codex-image-gen
# hf (Hugging Face) — installed via pip 'huggingface_hub[cli]' — see bootstrap.sh

# Each CLI must be authenticated interactively (separate login flow):
#   claude login
#   grok login (or auth)
#   codex login
#   hf auth login
