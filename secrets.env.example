# /etc/claude-soma/secrets.env — copy this file as the starting point
# Required keys are uncommented; optional keys are commented with "#"
# After editing, chmod 600 and chown ubuntu:ubuntu

# ========== PUBLIC DOMAIN (REQUIRED — set BEFORE running finalize-caddy.sh) ==========
# The base domain you own. The dashboard goes on soma.<this>, the file relay
# goes on files.<this> (override with FILES_DOMAIN below if you want a different
# host). DNS A records for both subdomains must point at this VPS's public IP
# before Caddy can obtain Let's Encrypt TLS certs.
# Example:  SOMA_DOMAIN=example.com    (dashboard becomes soma.example.com)
SOMA_DOMAIN=

# Optional: override the files-relay subdomain. Defaults to files.<SOMA_DOMAIN>.
# Set this only if you want the relay on a different host (e.g. cdn.example.com).
# FILES_DOMAIN=

# Email Let's Encrypt registers your TLS certs under. Used by Caddy. Required
# so cert-expiry warnings reach a real inbox.
# Example:  ACME_EMAIL=you@example.com
ACME_EMAIL=

# ========== CLAUDE / ANTHROPIC ==========
# Obtain via `claude login` on a dev machine first; required for the bot.
CLAUDE_CODE_OAUTH_TOKEN=

# ========== GITHUB OAUTH (dashboard auth) ==========
# Create at https://github.com/settings/developers (OAuth App)
# Callback URL: https://soma.<SOMA_DOMAIN>/api/auth/callback/github
# NOTE: NextAuth v5 reads AUTH_GITHUB_ID + AUTH_GITHUB_SECRET (not _CLIENT_ID / _CLIENT_SECRET).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated list of GitHub usernames allowed to access the dashboard.
# REQUIRED — without this, no one can log in. Set to your own GitHub username.
HERMES_ALLOWED_GITHUB_HANDLES=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full external URL to the dashboard:
NEXTAUTH_URL=https://soma.<SOMA_DOMAIN>

# ========== CORS (API service) ==========
# Comma-separated origins the API permits. Must include your soma domain + localhost for dev.
HERMES_API_CORS_ORIGINS=https://soma.<SOMA_DOMAIN>,http://localhost:3000

# ========== MESSAGING CHANNEL (choose ONE) ==========
# The bot runs exactly one messaging channel at a time. Set this to telegram or
# discord, then fill ONLY that channel's keys below.
SOMA_ACTIVE_CHANNEL=telegram

# ========== TELEGRAM (if SOMA_ACTIVE_CHANNEL=telegram) ==========
# Obtain TELEGRAM_BOT_TOKEN from @BotFather (DM @BotFather, send /newbot).
# After setting, run: bash /opt/claude-soma/scripts/setup-telegram.sh
# to mirror the token to the channel plugin and pair your Telegram account.
TELEGRAM_BOT_TOKEN=
# Your personal numeric Telegram chat ID. Run setup-telegram.sh — it auto-detects it.
# Or: DM your bot once, then GET https://api.telegram.org/bot<TOKEN>/getUpdates and read chat.id.
HERMES_NOTIFY_CHAT_ID=
# Same as HERMES_NOTIFY_CHAT_ID — fallback for older code paths
TELEGRAM_CHAT_ID=

# ========== DISCORD (if SOMA_ACTIVE_CHANNEL=discord) ==========
# Create an app + bot at https://discord.com/developers/applications
#   - On the Bot page, ENABLE "Message Content Intent" (required).
#   - Reset Token and paste it here.
#   - Invite the bot to a server you share (OAuth2 -> URL Generator -> scope: bot).
# After setting, run: bash /opt/claude-soma/scripts/setup-discord.sh
DISCORD_BOT_TOKEN=

# ========== FILES RELAY (basicauth password) ==========
# Plaintext password for the basicauth on FILES_DOMAIN
# After setting, regenerate the bcrypt hash in caddy/files.caddyfile (see INSTALL.md)
HERMES_FILES_PASSWORD=

# ========== AUTO-RESTART GUARD (optional) ==========
# Unix epoch (seconds) when the current auto-restart window expires.
# Leave commented to disable auto-restart.
# Example: 1796515200 (= 2026-12-01T00:00:00Z)
# HERMES_AUTO_RESTART_WINDOW_UTC=

# ========== USAGE-TAB CEILINGS (optional) ==========
# If set, the /admin/usage tab shows ceiling KpiCards with remaining-percent.
# If unset, ceiling cards are hidden (graceful).
# HERMES_INTERACTIVE_CEILING=10000
# HERMES_AGENT_SDK_CEILING=50000

# ========== ENGAGEMENT DRIP (optional knobs) ==========
# FRESH_MODE: when "on" (default), the hourly dispatcher
# (scripts/engagement-hourly-dispatch.sh) spawns a focused browse+draft
# subagent each hour to author fresh humanized comments on just-seen
# X + LinkedIn posts. When "off", the dispatcher skips the subagent and
# pops from the pre-authored pooled queue (lower cost, but the queue
# can go dry). Either way exactly one DM/hour is produced.
# HERMES_ENGAGEMENT_FRESH_MODE=on
# Browse depth per platform when FRESH_MODE=on.
# HERMES_ENGAGEMENT_BROWSE_DEPTH=25
# Hard ceiling on the browse+draft subagent's runtime (seconds).
# HERMES_ENGAGEMENT_SUBAGENT_TIMEOUT_SECS=720
# Below this threshold of queued (pooled) drafts, the drip script writes
# a REFILL_NEEDED flag. Mostly relevant when FRESH_MODE=off.
# HERMES_ENGAGEMENT_REFILL_THRESHOLD=6
# Override the queue + review-page paths if you've moved them:
# HERMES_ENGAGEMENT_QUEUE=/var/lib/claude-soma/engagement/queue.jsonl
# HERMES_ENGAGEMENT_REVIEW_PAGE=/var/lib/claude-soma/relay/engagement-review.md
# Dispatcher's structured per-run audit log:
# HERMES_ENGAGEMENT_DISPATCH_LOG=/var/log/claude-soma/engagement-dispatch.jsonl

# ========== HUGGING FACE (optional, for HF MCP / leads using hf CLI) ==========
# Obtain via `hf auth login` interactive flow.
# HUGGING_FACE_HUB_TOKEN=

# ========== EXTERNAL CLI BINARIES — install separately ==========
# grok (xAI) — install from https://grok.com/cli — required for grok-image MCP
# codex (OpenAI Codex) — install from https://github.com/openai/codex — required for codex-image-gen
# hf (Hugging Face) — installed via pip 'huggingface_hub[cli]' — see bootstrap.sh

# Each CLI must be authenticated interactively (separate login flow):
#   claude login
#   grok login (or auth)
#   codex login
#   hf auth login
