# Disable pnpm's strict-dep-builds gate at the project level so every nested
# pnpm invocation (including `pnpm rebuild`'s internal runDepsStatusCheck on
# pnpm 11+) inherits the setting and doesn't trip ERR_PNPM_IGNORED_BUILDS.
#
# The allow-list itself still lives in pnpm-workspace.yaml under
# onlyBuiltDependencies. This file just keeps the gate from being fatal.
#
# See scripts/build_frontend.sh — "THE KEY FLAG" section — for the full reasoning.
strict-dep-builds=false
